# --- MQTT (the same broker Frigate publishes to) ---
# Use the broker's host name or IP. "localhost" will NOT reach a broker on the
# Docker host from inside this container.
MQTT_HOST=mqtt.example.lan
MQTT_PORT=1883
MQTT_USER=catid
MQTT_PASSWORD=change-me

# --- Frigate paths on the Docker HOST (used by compose.yaml volumes) ---
# Folder holding frigate.db (Frigate's /config)
FRIGATE_CONFIG_DIR=/path/to/frigate/config
# <Frigate media>/clips/<Name>/dataset - one sub-folder per pet, e.g. Tom/, Luna/
FRIGATE_DATASET_DIR=/path/to/frigate/media/clips/Pets/dataset

# --- Tuning (defaults shown) ---
# LABELS=cat,dog,bird
# MIN_SCORE=0.55
# MIN_MARGIN=0.01
# REBUILD_SECONDS=900
# TOPIC_PREFIX=catid
# FRIGATE_TOPIC_PREFIX=frigate
# HA_DISCOVERY_PREFIX=homeassistant
# MQTT_CLIENT_ID=cat-id
# LOG_LEVEL=INFO
